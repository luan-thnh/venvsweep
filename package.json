{
  "name": "venvsweep",
  "version": "0.1.1",
  "description": "Interactive CLI to find and safely remove Python virtual environments.",
  "type": "module",
  "bin": {
    "venvsweep": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "python",
    "venv",
    "virtualenv",
    "cli",
    "cleanup",
    "disk-space",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "homepage": "https://luan-thnh.github.io/venvsweep/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luan-thnh/venvsweep.git"
  },
  "bugs": {
    "url": "https://github.com/luan-thnh/venvsweep/issues"
  },
  "author": "luan-thnh",
  "publishConfig": {
    "access": "public"
  }
}
